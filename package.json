{
  "name": "dsh-render-document",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: a render_document tool that rasterizes Office documents and PDFs to PNG pages for layout checks, without sandbox escalation.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "render",
    "docx",
    "xlsx",
    "pptx",
    "libreoffice",
    "word",
    "layout"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.2 || ^0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      },
      "node": ">=22.19.0"
    }
  }
}
